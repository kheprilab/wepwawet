{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "ignore": [
      ".wep/",
      "dist/",
      "node_modules/",
      "coverage/",
      "pnpm-lock.yaml",
      "evals/.cache/**",
      "evals/experiments/*/validation/runs/**",
      "evals/experiments/*/validation/hono-4961/**",
      "evals/experiments/*/validation/flask-5917/**",
      "evals/experiments/*/container/release-source.tar",
      "evals/experiments/*/container/metrics.mjs",
      "evals/experiments/*/pilot/raw/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error"
      },
      "security": {
        "noGlobalEval": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
